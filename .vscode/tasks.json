{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-vng-gdb",
            "type": "shell",
            "command": "make",
            "args": [
                "run-vng-gdb",
                "DEBUG=1",
                "VNG_RW=1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
